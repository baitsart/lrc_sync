#!/usr/bin/env bash

srt2lrc() {
awk '
function to_lrc(t,    a, mins, secs, ms, cs) {
    gsub(/,/, ".", t)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
    split(t, a, "[:.]")

    mins = (a[1] + 0) * 60 + (a[2] + 0)
    secs = a[3] + 0
    ms   = substr(a[4] "000", 1, 3) + 0

    # Convertir milisegundos (0-999) a centésimas (0-99) con redondeo
    cs = int((ms + 5) / 10)
    if (cs >= 100) {
        cs = 0
        secs += 1
        if (secs >= 60) {
            secs = 0
            mins += 1
        }
    }

    return sprintf("[%02d:%02d.%02d]", mins, secs, cs)
}

BEGIN {
    last_text = ""
    start = ""
}

/-->/ {
    split($0, a, "-->")
    start = a[1]
    next
}

# Eliminar índices numéricos de bloque
/^[0-9]+[[:space:]]*$/ { next }

# Ignorar líneas vacías
/^[[:space:]]*$/ { next }

{
    gsub(/<[^>]+>/, "", $0)
    gsub(/\[[^\]]*\]/, "", $0)
    gsub(/\r$/, "", $0)

    text = $0

    if (start != "" && text != "" && text != last_text) {
        print to_lrc(start) text
        last_text = text
    }
}
' "$1" > "${1%.srt}.lrc"
}

# Uso
srt2lrc "$1"
